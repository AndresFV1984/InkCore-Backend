# Copia a .env y ajusta si quieres (opcional). Docker Compose lo carga automáticamente.
# Tag de imagen: v + día.mes (ej. v22.07). Usar .\scripts\docker\push-hub.ps1 para generar/publicar.
IMAGE_TAG=latest
POSTGRES_OWNER_PASSWORD=YyZUdfRUcjJmiFxrkr5DP77mZD4hlRo1
POSTGRES_APP_PASSWORD=5p5g+OQu9X6/cdi23jLKiTqSpAfgWCiS
# Solo referencia (docker-init crea inkcore_admin con este password local)
POSTGRES_ADMIN_PASSWORD=kpDh7QcJVviWaxU91wLYyv2wIMECIUUb
JWT_SECRET=cambia-esto-en-produccion-por-clave-segura
JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxRAMPercentage=75.0
REFRESH_TOKEN_STORE_TYPE=memory
TOKEN_VERSION_CACHE_TYPE=memory
# Perfil Spring: usar solo dev o prod (NO "docker")
# SPRING_PROFILES_ACTIVE=dev
# CORS (CSV). En compose local ya hay default localhost:8085
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com

# --- Object storage / estimar tintas (PUT directo del navegador a MinIO) ---
# MinIO debe estar arriba (compose: servicio minio en host :9100).
# Si el front se abre por IP LAN (ej. http://192.168.1.250:8085), NO uses localhost
# en la URL prefirmada: el navegador intentaría subir a su propio localhost.
# OBJECT_STORAGE_PUBLIC_ENDPOINT=http://192.168.1.250:9100
# OBJECT_STORAGE_CORS_ORIGINS=http://localhost:8085,http://127.0.0.1:8085,http://192.168.1.250:8085
# Con Spring perfil "dev" (sin Compose), por defecto type=memory → URLs memory:// que el browser no puede PUT.
# Para probar uploads reales en local: OBJECT_STORAGE_TYPE=s3 y MinIO en :9100.
